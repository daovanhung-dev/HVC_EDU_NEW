{
  "name": "hung-cuong-management",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "test": "npm run test --workspace frontend",
    "test:run": "npm run test:run --workspace frontend",
    "import:student-roster": "deno run --allow-net --allow-env --allow-read --allow-write scripts/import-student-roster.ts",
    "test:student-roster": "deno test --allow-env scripts/import-student-roster.test.ts",
    "rotate:student-passwords": "deno run --allow-net --allow-env --allow-read --allow-write scripts/rotate-student-passwords.ts",
    "test:student-passwords": "deno test --allow-env scripts/rotate-student-passwords.test.ts",
    "import:class-schedules": "deno run --allow-net --allow-env --allow-read scripts/import-class-schedules.ts",
    "test:class-schedules": "deno test --allow-env scripts/import-class-schedules.test.ts",
    "import:staff-schedule": "deno run --allow-net --allow-env --allow-read --allow-write scripts/import-staff-schedule.ts",
    "test:staff-schedule": "deno test --allow-env scripts/import-staff-schedule.test.ts",
    "preview": "npm run preview --workspace frontend"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  }
}
